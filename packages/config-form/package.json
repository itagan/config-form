{
  "name": "@itagan/config-form",
  "version": "0.3.0",
  "description": "Vue 2.7 + Element UI configuration-driven form component.",
  "type": "module",
  "main": "./dist/config-form.umd.cjs",
  "module": "./dist/config-form.es.js",
  "types": "./dist/types/public-types.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/public-types.d.ts",
      "import": "./dist/config-form.es.js",
      "require": "./dist/config-form.umd.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": ["*.css", "**/*.css"],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "author": "itagan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itagan/config-form.git",
    "directory": "packages/config-form"
  },
  "homepage": "https://github.com/itagan/config-form#readme",
  "bugs": {
    "url": "https://github.com/itagan/config-form/issues"
  },
  "scripts": {
    "build": "run-s build:lib build:types",
    "build:lib": "vite build",
    "build:types": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:performance": "CONFIG_FORM_BENCHMARK=1 vitest run src/__tests__/ConfigForm.performance.test.ts --reporter=verbose",
    "type-check": "vue-tsc -p tsconfig.json --noEmit",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm --workspace-root publish:check"
  },
  "peerDependencies": {
    "element-ui": "^2.4.9",
    "vue": "^2.7.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "0.34.6",
    "@vue/test-utils": "1.3.6",
    "element-ui": "^2.15.14",
    "vitest": "0.34.6",
    "vue": "2.7.16",
    "vue-template-compiler": "2.7.16"
  },
  "keywords": ["vue2", "element-ui", "form", "schema-form", "typescript"],
  "license": "MIT"
}
