{
  "name": "@itagan/config-form",
  "version": "0.1.0",
  "description": "Vue 2.7 + Element UI configuration-driven form component.",
  "type": "module",
  "main": "./dist/config-form.umd.cjs",
  "module": "./dist/config-form.es.js",
  "types": "./dist/types/public-types.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/public-types.d.ts",
      "import": "./dist/config-form.es.js",
      "require": "./dist/config-form.umd.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": ["*.css", "**/*.css"],
  "scripts": {
    "build": "run-s build:lib build:types",
    "build:lib": "vite build",
    "build:types": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "type-check": "vue-tsc -p tsconfig.json --noEmit",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "element-ui": "^2.4.9",
    "vue": "^2.7.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "0.34.6",
    "@vue/test-utils": "1.3.6",
    "element-ui": "^2.15.14",
    "vitest": "0.34.6",
    "vue": "2.7.16",
    "vue-template-compiler": "2.7.16"
  },
  "keywords": ["vue2", "element-ui", "form", "schema-form", "typescript"],
  "license": "MIT"
}
