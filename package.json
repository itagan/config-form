{
  "name": "configform-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.31.0",
  "scripts": {
    "dev": "pnpm --filter configform-playground dev",
    "preview": "pnpm --filter configform-playground preview",
    "docs:install": "pnpm --dir docs --ignore-workspace install --frozen-lockfile",
    "docs:dev": "pnpm --dir docs --ignore-workspace dev",
    "docs:build": "run-s docs:install docs:build-only",
    "docs:build-only": "pnpm --dir docs --ignore-workspace build",
    "docs:check": "node scripts/check-docs.mjs",
    "docs:preview": "pnpm --dir docs --ignore-workspace preview",
    "site:dev": "run-p dev docs:dev",
    "build": "run-s build:package build:playground docs:build",
    "build:package": "pnpm --filter @itagan/config-form build",
    "build:playground": "pnpm --filter configform-playground build",
    "build:playground:site": "pnpm --filter configform-playground build:site",
    "site:build": "VITE_SITE_BASE=/ run-s site:build:base",
    "site:build:base": "run-s docs:build build:playground:site",
    "site:build:github": "VITE_SITE_BASE=/config-form/ run-s site:build:base",
    "site:check": "node scripts/check-site-build.mjs",
    "site:check:github": "VITE_SITE_BASE=/config-form/ node scripts/check-site-build.mjs",
    "site:preview": "pnpm docs:preview",
    "test": "pnpm --filter @itagan/config-form test",
    "test:coverage": "pnpm --filter @itagan/config-form test:coverage",
    "test:performance": "pnpm --filter @itagan/config-form test:performance",
    "lint": "eslint --ext .ts,.vue packages/config-form/src packages/config-form-min-peer/src playground/src",
    "type-check": "pnpm -r type-check",
    "compat:check": "pnpm --filter config-form-min-peer-check check",
    "pack:check": "node scripts/check-package.mjs",
    "release:meta-check": "node scripts/check-release-metadata.mjs",
    "publish:ready-check": "node scripts/check-publish-ready.mjs",
    "publish:check": "run-s release:check publish:ready-check",
    "release:check": "run-s release:meta-check lint test:coverage type-check build:package compat:check docs:check site:build site:check pack:check"
  },
  "devDependencies": {
    "@types/node": "^16.11.45",
    "@typescript-eslint/eslint-plugin": "5.62.0",
    "@typescript-eslint/parser": "5.62.0",
    "@vitejs/plugin-vue2": "^1.1.2",
    "@vue/tsconfig": "^0.1.3",
    "eslint": "8.57.1",
    "eslint-plugin-vue": "9.33.0",
    "jsdom": "21.1.2",
    "less": "^4.4.0",
    "npm-run-all": "^4.1.5",
    "typescript": "~4.7.4",
    "vite": "^3.0.2",
    "vue": "2.7.16",
    "vue-tsc": "^0.38.8"
  }
}
